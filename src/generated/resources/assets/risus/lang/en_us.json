  "entity.risus.player_doesnt_own": "I don't like you",
  "entity.risus.question_mark": "???",
  "entity.risus.risus_boat": "Boat",
  "entity.risus.singer": "Singer",
  "entity.risus.stalker": "Stalker",
  "entity.risus.thrown_axe": "Thrown Crescent Disaster",
  "entity.risus.thrown_axe.message0": "I missed you",
  "entity.risus.thrown_axe.message1": "I love the way you grip me",
  "entity.risus.thrown_axe.message10": "I recall that pig...",
  "entity.risus.thrown_axe.message11": "Let me feel your fingers on me",
  "entity.risus.thrown_axe.message12": "Please hold me with both of your hands",
  "entity.risus.thrown_axe.message13": "I adore the color of your blood",
  "entity.risus.thrown_axe.message14": "Just a little more...",
  "entity.risus.thrown_axe.message15": "Who's that behind you?",
  "entity.risus.thrown_axe.message16": "Are you sure that you are alone?",
  "entity.risus.thrown_axe.message17": "These lands have changed so much",
  "entity.risus.thrown_axe.message18": "I feel the Birthplace trembling",
  "entity.risus.thrown_axe.message19": "You didn't abandon me...?",
  "entity.risus.thrown_axe.message2": "Where am I...?",
  "entity.risus.thrown_axe.message20": "Till Death do us part",
  "entity.risus.thrown_axe.message21": "I can sense my... Composer",
  "entity.risus.thrown_axe.message3": "I remember... You",
  "entity.risus.thrown_axe.message4": "I hear them",
  "entity.risus.thrown_axe.message5": "They are calling for me",
  "entity.risus.thrown_axe.message6": "Beware the edge where the Old Witness crossed",
  "entity.risus.thrown_axe.message7": "No one will believe you",
  "entity.risus.thrown_axe.message8": "I yearn for more",
  "entity.risus.thrown_axe.message9": "How many have I killed?",
